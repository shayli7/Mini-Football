# Unity generated / machine-specific folders — all regenerate on open, never commit them
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta files must NOT be ignored (Unity needs them tracked)
!/[Aa]ssets/**/*.meta

# Autogenerated VS / Rider / IDE project files
/.vs/
/.vsconfig
/.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt

# Android / IL2CPP build intermediates
/.utmp/
/[Ii]l2[Cc]ppOutputProject/

# Built players / packages
*.apk
*.aab
*.unitypackage
*.app

# OS cruft
.DS_Store
Thumbs.db

# Gradle / Android build intermediates
.gradle/
.consulo/
ExportedObj/

# Agent/tool scratch — regenerated, never part of a change
/.claude-flow/
**/.claude-flow/
/run.log
/MEMORY.md
# Blender render staging; the shipped copies live in Assets/Resources/
/Art/out/
# Unity Performance Testing artifacts
/Assets/Resources/PerformanceTestRun*.json
/Assets/Resources/PerformanceTestRun*.json.meta
