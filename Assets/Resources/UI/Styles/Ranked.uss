/* Ranked. See LeagueMenu.cs. Laid out against a 760-unit-high panel.
   Every selector is under .ranked so it outranks the shared frame defaults in Base.uss. */

/* ---------- header ---------- */

.ranked .rk__header {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 24px;
    height: 58px;
    align-items: center;
    justify-content: center;
}

.ranked .rk__back { position: absolute; left: 0; top: 0; }
.ranked .rk__tools { position: absolute; right: 0; top: 3px; flex-direction: row; align-items: center; }
.ranked .rk__coin-chip { margin-left: 12px; }
.ranked .rk__title-box { align-items: center; }
.ranked .rk__title-row { flex-direction: row; align-items: center; }
.ranked .rk__title-row .icon { width: 26px; height: 26px; }
.ranked .rk__title { font-size: 32px; letter-spacing: 7px; margin-left: 12px; }
.ranked .rk__bar { width: 44px; height: 3px; margin-top: 6px; background-color: var(--pulse); }

.ranked .sq {
    width: 55px;
    height: 55px;
    align-items: center;
    justify-content: center;
    --frame-fill: #0F1C31;
    --frame-edge: #2C5A8E;
    --frame-edge-width: 1.5;
    --frame-cut: 10;
    transition-property: scale;
    transition-duration: 0.12s;
}

.ranked .sq:hover { scale: 1.05 1.05; }
.ranked .sq:active { scale: 0.95 0.95; }
.ranked .sq .icon { width: 26px; height: 26px; }

/* ---------- headings ---------- */

.ranked .rk__heading {
    flex-direction: row;
    align-items: center;
    height: 34px;
    margin-bottom: 12px;
}

.ranked .rk__heading .icon { width: 20px; height: 20px; }
.ranked .rk__heading-label { font-size: 15px; letter-spacing: 5px; margin-left: 10px; }
.ranked .rk__heading-rule { flex-grow: 1; height: 1px; margin-left: 14px; background-color: #24456F; }

/* ---------- left: your league ---------- */

.ranked .rk__side {
    position: absolute;
    left: 40px;
    top: 104px;
    bottom: 36px;
    width: 350px;
    padding: 22px 22px 22px 22px;
    justify-content: space-between;
}

.ranked .rk__id { flex-direction: row; align-items: center; }
.ranked .rk__badge { width: 84px; height: 84px; margin-right: 16px; }
.ranked .rk__id-words { flex-grow: 1; flex-shrink: 1; }
.ranked .rk__league { font-size: 30px; letter-spacing: 3px; }
.ranked .rk__standing { font-size: 15px; letter-spacing: 2px; color: var(--muted); margin-top: 4px; }

.ranked .rk__zone {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background-color: #0B1628;
}

.ranked .rk__zone-label { font-size: 14px; letter-spacing: 3px; }
.ranked .rk__timer { flex-direction: row; align-items: center; }
.ranked .rk__timer .icon { width: 16px; height: 16px; }
.ranked .rk__timer-label { font-size: 14px; letter-spacing: 1px; color: var(--muted); margin-left: 6px; }

.ranked .rk__rungs { margin: 4px 0; }

.ranked .rk__rung {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    margin-bottom: 4px;
    background-color: #0B1628;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.ranked .rk__rung-dot { width: 12px; height: 12px; border-radius: 6px; opacity: 0.5; }
.ranked .rk__rung-name { font-size: 15px; letter-spacing: 3px; color: var(--dim); margin-left: 14px; flex-grow: 1; }
.ranked .rk__rung-you { font-size: 12px; letter-spacing: 3px; display: none; }

.ranked .rk__rung.is-here { background-color: #0F1C31; border-left-color: #3DE3FF; }
.ranked .rk__rung.is-here .rk__rung-dot { opacity: 1; }
.ranked .rk__rung.is-here .rk__rung-name { color: var(--ink); }
.ranked .rk__rung.is-here .rk__rung-you { display: flex; }

.ranked .rk__pay {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px 10px 14px;
    --frame-fill: #0B1628;
    --frame-edge: #24456F;
    --frame-edge-width: 1.5;
    --frame-cut: 10;
}

.ranked .rk__pay .coin { width: 26px; height: 26px; }
.ranked .rk__pay-label { font-size: 14px; letter-spacing: 1px; margin-left: 10px; flex-grow: 1; flex-shrink: 1; white-space: normal; }
.ranked .rk__pay-claim { height: 40px; padding: 0 14px; margin-left: 8px; }
.ranked .rk__pay-claim .btn__label { font-size: 13px; letter-spacing: 2px; }

.ranked .rk__play { margin-top: 12px; height: 58px; }

.ranked .rk__debug { flex-direction: row; margin-top: 10px; }
.ranked .rk__debug .btn { flex-grow: 1; height: 34px; padding: 0 6px; margin-right: 6px; }
.ranked .rk__debug .btn__label { font-size: 11px; letter-spacing: 1px; }

/* ---------- middle: the podium ---------- */

.ranked .rk__center {
    position: absolute;
    left: 414px;
    right: 500px;
    top: 104px;
    bottom: 36px;
}

.ranked .rk__podium {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 8px;
}

.ranked .rk__step-col { flex-grow: 1; flex-basis: 0; align-items: center; margin: 0 6px; }

.ranked .rk__pod-hex { width: 74px; height: 74px; align-items: center; justify-content: center; margin-bottom: 8px; }
.ranked .rk__pod-hex--first { width: 96px; height: 96px; }
.ranked .rk__pod-initial { font-size: 28px; -unity-text-align: middle-center; }
.ranked .rk__step-col--first .rk__pod-initial { font-size: 36px; }

.ranked .rk__pod-name { font-size: 16px; letter-spacing: 1px; max-width: 130px; overflow: hidden; -unity-text-align: middle-center; }
.ranked .rk__pod-pts { font-size: 14px; letter-spacing: 2px; color: var(--muted); margin: 2px 0 10px 0; }

.ranked .rk__step {
    align-self: stretch;
    align-items: center;
    justify-content: center;
    --frame-cut: 14;
    --frame-edge-width: 2;
}

.ranked .rk__step-rank { font-size: 44px; -unity-text-align: middle-center; }
.ranked .rk__step-col--first .rk__step-rank { font-size: 60px; }

.ranked .rk__up { position: absolute; top: 8px; right: 8px; width: 20px; height: 20px; rotate: -90deg; }

.ranked .rk__you-tag {
    position: absolute;
    bottom: 8px;
    font-size: 12px;
    letter-spacing: 3px;
    color: #03161C;
    background-color: #3DE3FF;
    padding: 2px 8px;
}

/* ---------- right: the pod ---------- */

.ranked .rk__right {
    position: absolute;
    right: 40px;
    top: 104px;
    bottom: 36px;
    width: 440px;
}

.ranked .rk__list { flex-grow: 1; }

.ranked .rk__row {
    flex-direction: row;
    align-items: center;
    height: 38px;
    margin: 0 14px 4px 14px;
    padding: 0 14px;
    --frame-fill: #0B1628;
    --frame-edge: #1D3557;
    --frame-edge-width: 1;
    --frame-cut: 8;
}

.ranked .rk__row-rank { font-size: 15px; width: 34px; color: var(--muted); }
.ranked .rk__row-words { flex-grow: 1; flex-shrink: 1; }
.ranked .rk__row-name { font-size: 16px; letter-spacing: 1px; overflow: hidden; }
.ranked .rk__row-pts { font-size: 16px; letter-spacing: 1px; color: var(--ink); min-width: 56px; -unity-text-align: middle-right; }
.ranked .rk__down { width: 18px; height: 18px; rotate: 90deg; margin-right: 12px; }

.ranked .rk__row--down .rk__row-rank,
.ranked .rk__row--down .rk__row-name,
.ranked .rk__row--down .rk__row-pts { color: var(--danger); }

/* Your row: twice the height, cyan, wider than its neighbours and lit from behind. */
.ranked .rk__row--you {
    height: 76px;
    margin: 8px 0 12px 0;
    padding: 0 20px 0 18px;
    --frame-edge-width: 2;
    --frame-cut: 12;
}

.ranked .rk__row-glow {
    position: absolute;
    left: -6px;
    right: -6px;
    top: -6px;
    bottom: -6px;
    background-color: rgba(61, 227, 255, 0.10);
}

.ranked .rk__row--you .rk__row-rank { font-size: 28px; width: 50px; color: var(--pulse); }
.ranked .rk__row--you .rk__row-name { font-size: 20px; color: var(--pulse); }
.ranked .rk__row--you .rk__row-pts { font-size: 24px; color: var(--pulse); }
.ranked .rk__row-gap { font-size: 12px; letter-spacing: 2px; color: var(--muted); margin-top: 3px; }
