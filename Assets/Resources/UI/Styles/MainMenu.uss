/* Main menu. See MainMenu.cs. Laid out against a 760-unit-high panel.
   Every selector is under .menu so it outranks the shared frame defaults in Base.uss, and the frame
   colours are literal hex on purpose (see UiFrame): they mirror ArcadeTheme. */

/* The floor is the Arena (UiBackdrop). */

/* ---------- header ---------- */

.menu .menu__header {
    position: absolute;
    left: 36px;
    right: 36px;
    top: 22px;
    height: 72px;
    flex-direction: row;
    align-items: center;
}

.menu .menu__profile {
    flex-direction: row;
    align-items: center;
    height: 70px;
    padding: 0 22px 0 10px;
    --frame-fill: #0A1322;
    --frame-edge: #24456F;
    --frame-edge-width: 1;
    --frame-cut: 12;
    transition-property: scale;
    transition-duration: 0.12s;
}

.menu .menu__profile:hover { scale: 1.02 1.02; }
.menu .menu__profile:active { scale: 0.98 0.98; }

.menu .menu__hex {
    width: 54px;
    height: 54px;
    align-items: center;
    justify-content: center;
}

.menu .avatar__initial {
    font-size: 22px;
    color: var(--pulse);
    -unity-text-align: middle-center;
}

.menu .menu__profile-info { margin-left: 14px; }

.menu .menu__name-badge { margin-right: 8px; }

.menu .menu__name {
    font-size: 18px;
    letter-spacing: 2px;
    max-width: 300px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.menu .level-pill {
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--pulse);
    background-color: rgba(61, 227, 255, 0.14);
    padding: 3px 8px;
    margin-left: 10px;
}

/* Rewards waiting on the level path: a small gold chest and a count. */
.menu .menu__badge {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 7px;
    margin-left: 8px;
    background-color: var(--reward);
}

.menu .menu__badge .icon { width: 12px; height: 12px; margin-right: 4px; }

.menu .menu__badge-label {
    font-size: 12px;
    color: var(--on-reward);
}

.menu .menu__xp-row { margin-top: 7px; }

.menu .menu__xp-bar {
    width: 170px;
    height: 6px;
    border-radius: 0;
}

.menu .menu__xp-bar .bar__fill { border-radius: 0; }

.menu .menu__xp-label {
    font-size: 12px;
    color: var(--muted);
    margin-left: 10px;
}

.menu .menu__chip {
    flex-direction: row;
    align-items: center;
    height: 52px;
    margin-left: 12px;
    padding: 0 18px 0 14px;
    --frame-fill: #0A1322;
    --frame-edge: #24456F;
    --frame-edge-width: 1;
    --frame-cut: 8;
    transition-property: scale;
    transition-duration: 0.12s;
}

.menu .menu__chip:hover { scale: 1.03 1.03; }
.menu .menu__chip:active { scale: 0.97 0.97; }

.menu .menu__chip .icon { width: 24px; height: 24px; }

.menu .menu__chip-value {
    font-size: 20px;
    margin-left: 10px;
}

/* The connection chip: red, and only there when there is no connection. */
.menu .menu__chip--offline {
    --frame-fill: #1A0B11;
    --frame-edge: #FF5C72;
    --frame-edge-width: 1.5;
}

.menu .menu__chip-value--offline {
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--danger);
}

/* ---------- wordmark ---------- */

.menu .menu__logo {
    position: absolute;
    top: 104px;
    left: 0;
    right: 0;
    align-items: center;
}

.menu .menu__mini {
    font-size: 15px;
    letter-spacing: 14px;
    padding-left: 14px;
    color: var(--muted);
    -unity-text-align: middle-center;
}

.menu .menu__wordmark {
    flex-direction: row;
    align-items: center;
}

.menu .menu__football {
    font-size: 46px;
    letter-spacing: 8px;
    margin: 0 18px;
    text-shadow: 0 0 24px rgba(61, 227, 255, 0.35);
    -unity-text-align: middle-center;
}

.menu .menu__rule {
    width: 60px;
    height: 2px;
    background-color: var(--pulse);
}

.menu .menu__caption {
    position: absolute;
    top: 176px;
    left: 0;
    right: 0;
    font-size: 13px;
    letter-spacing: 4px;
    color: var(--muted);
    -unity-text-align: middle-center;
}

/* ---------- cards ---------- */

.menu .menu__cards {
    position: absolute;
    top: 206px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.menu .card {
    width: 372px;
    height: 410px;
    margin: 0 13px;
    padding: 10px;
    --frame-fill: #0A1322;
    --frame-edge: #2C5A8E;
    --frame-edge-width: 1.5;
    --frame-cut: 18;
    --frame-tab: #3DE3FF;
}

.menu .card.enter {
    transition-property: opacity, translate, scale;
    transition-duration: 0.42s, 0.42s, 0.12s;
    transition-timing-function: ease-out-cubic;
}

.menu .card:hover { scale: 1.02 1.02; }
.menu .card:active { scale: 0.97 0.97; }

.menu .card.enter-from {
    opacity: 0;
    translate: 0 26px;
}

/* Inset from the card's edge so the picture's corners stay inside the cut ones. */
.menu .card__picture {
    height: 320px;
    overflow: hidden;
    background-color: #07101E;
    -unity-background-scale-mode: scale-and-crop;
}

/* A dark ramp up from the foot, so the title reads over any picture. */
.menu .card__shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60%;
    -unity-background-scale-mode: stretch-to-fill;
}

.menu .card__bracket {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 22px;
    height: 22px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-color: var(--pulse);
}

.menu .card__badge {
    position: absolute;
    top: 14px;
    left: 22px;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    --frame-fill: rgba(4, 7, 13, 0.78);
    --frame-edge: #3DE3FF;
    --frame-edge-width: 1.5;
    --frame-cut: 8;
}

.menu .card__badge .icon { width: 24px; height: 24px; }

.menu .card__foot {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 14px;
}

.menu .card__title-row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.menu .card__title {
    font-size: 28px;
    letter-spacing: 3px;
    text-shadow: 0 2px 12px rgba(4, 7, 13, 0.9);
}

.menu .card__line {
    font-size: 15px;
    color: var(--muted);
    margin-top: 2px;
}

.menu .card__play {
    height: 56px;
    margin-top: 10px;
    padding: 0;
}

.menu .card__play .icon {
    width: 16px;
    height: 16px;
    margin-right: 10px;
}

/* The Online card, offline: the edge and tab go quiet, the picture dims, the strip is a locked grey. */
.menu .card.is-locked {
    --frame-edge: #1D3557;
    --frame-tab: rgba(0, 0, 0, 0);
}

.menu .card.is-locked .card__picture { opacity: 0.45; }
.menu .card.is-locked .card__title { color: var(--muted); }
.menu .card.is-locked .card__badge { --frame-edge: #56698A; }

.menu .card__offline {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 40px;
    align-items: center;
    justify-content: center;
}

.menu .card__offline .icon { width: 84px; height: 84px; }

.menu .card__live {
    position: absolute;
    top: 24px;
    right: 46px;
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    background-color: rgba(4, 7, 13, 0.78);
}

.menu .card__live-dot {
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 4px;
    background-color: #4CE0A0;
}

.menu .card__live-label {
    font-size: 11px;
    letter-spacing: 2px;
    color: #4CE0A0;
}

/* Strength meter on the difficulty cards. */
.menu .meter {
    flex-direction: row;
    align-items: flex-end;
    height: 24px;
}

.menu .meter__bar {
    width: 8px;
    margin-left: 4px;
    background-color: var(--raised);
}

.menu .meter__bar--1 { height: 10px; }
.menu .meter__bar--2 { height: 17px; }
.menu .meter__bar--3 { height: 24px; }
.menu .meter__bar.is-lit { background-color: var(--pulse); }

.menu .menu__back {
    position: absolute;
    left: 36px;
    bottom: 30px;
    width: 132px;
    height: 52px;
    padding: 0;
}

.menu .menu__back .icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
}

/* ---------- bottom bar ---------- */

.menu .nav-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    align-items: center;
}

.menu .nav {
    flex-direction: row;
    padding: 6px;
    --frame-fill: #0A1322;
    --frame-edge: #24456F;
    --frame-edge-width: 1;
    --frame-cut: 14;
}

.menu .nav__item {
    width: 140px;
    height: 72px;
    align-items: center;
    justify-content: center;
    transition-property: background-color, scale;
    transition-duration: 0.12s, 0.12s;
}

.menu .nav__item:hover { background-color: var(--plate); }
.menu .nav__item:active { scale: 0.95 0.95; }

.menu .nav__item .icon {
    width: 28px;
    height: 28px;
}

.menu .nav__label {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--ink);
    margin-top: 6px;
    -unity-text-align: middle-center;
}

.menu .nav__pip {
    position: absolute;
    top: 6px;
    right: 34px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    background-color: var(--reward);
    color: var(--on-reward);
    font-size: 11px;
    -unity-text-align: middle-center;
}

/* ---------- invitation ---------- */

.menu .invite {
    position: absolute;
    top: 104px;
    right: 36px;
    width: 540px;
    height: 76px;
    flex-direction: row;
    align-items: center;
    padding: 0 14px 0 18px;
    --frame-fill: #0F1C31;
    --frame-edge: #3DE3FF;
    --frame-edge-width: 1.5;
    --frame-cut: 14;
}

.menu .invite__text {
    font-size: 15px;
    color: var(--pulse);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.menu .invite__btn {
    height: 46px;
    padding: 0 18px;
    margin-left: 8px;
}
