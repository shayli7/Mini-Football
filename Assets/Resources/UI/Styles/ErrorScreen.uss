/*
 * Error screen and toast (ErrorScreen.cs). Colours come from Base.uss; red is "you lose something",
 * so the panel's accent tab is danger and the actions use the shared .btn variants.
 */

.error__panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 520px;
    margin-left: -260px;
    margin-top: -170px;
    padding: 36px 40px;
    align-items: center;
    --frame-tab: #FF5C72;
    --frame-edge: #FF5C72;
}

.error__icon {
    width: 64px;
    height: 64px;
    margin-bottom: 18px;
}

.error__icon .icon, .error__icon > * {
    width: 64px;
    height: 64px;
}

.error__title {
    font-size: 26px;
    letter-spacing: 4px;
    color: var(--danger);
    -unity-text-align: middle-center;
}

.error__message {
    font-size: 18px;
    color: var(--muted);
    white-space: normal;
    margin-top: 10px;
    -unity-text-align: upper-center;
}

.error__buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 28px;
}

.error__buttons .btn { margin: 0 8px; min-width: 170px; }

/* The toast never takes the pointer; it only sits over the screen for a few seconds. */
.error__toast {
    position: absolute;
    top: 20px;
    left: 50%;
    width: 460px;
    margin-left: -230px;
    flex-direction: row;
    align-items: center;
    padding: 12px 18px;
    --frame-fill: #1A0B11;
    --frame-edge: #FF5C72;
    --frame-cut: 10;
}

.error__toast-icon {
    width: 24px;
    height: 24px;
    margin-right: 12px;
    flex-shrink: 0;
}

.error__toast-text {
    font-size: 16px;
    flex-shrink: 1;
    white-space: normal;
}
